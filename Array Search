#include <iostream>

using namespace std;

int search(int point, const int numbers[], int ARRAY_SIZE){
    for (int i = 0; i < ARRAY_SIZE; i++){
        if (numbers[i] == point){
            return i;
        }
        else if(i == ARRAY_SIZE-1){
            return -1;
        }
    }
}

int main()
{
    const int ARRAY_SIZE = 5;
    int numbers[ARRAY_SIZE] = {5, 10, 15, 20, 25};
    
    int index = search(15, numbers, ARRAY_SIZE);
    
    if (index < 0){
        cout << "the number was not found.";
    }
    else {
        cout << "the number was found at index " << index;
    }

    return 0;
}
