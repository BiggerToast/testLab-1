#include <iostream>

using namespace std;

int search(int point, const int arr[], int size){
    for (int i = 0; i < size; i++){
        if (arr[i] == point){
            return i;
        }
    }
    return -1;
}

//point is the 15
// arr is the = to the will be the diffrent numbers in the ARRAY_SIZE
// size is just the ARRAY_SIZE from 0-4

int main()
{
    const int ARRAY_SIZE = 5;
    int numbers[ARRAY_SIZE] = {5, 10, 15, 20, 25};
    
    int index = search(15, numbers, ARRAY_SIZE);
    
    if (index < 0){
        cout << "the number was not found.";
    }
    else {
        cout << "the number was found at index " << index;
    }

    return 0;
}
