#include <iostream>
#include <algorithm>
#include <fstream>
using namespace std;

    //althletes in a row
    const int rows = 7;
    //judges for columns
    const int column = 8;
    
void loads(string contests[], double score[][column]){
    
    ifstream fin("swimming_scores.txt");
    for(int i = 0; !fin.eof() && i < rows; i++){
        fin >> contests[i];
        for (int j = 0; j < column; j++){
            fin >>  score[i][j];
        }
    }
    
    
    fin.close();
}

void sortRows(double score[][column]) {
    for (int i = 0; i < rows; ++i) {
        sort(score[i], score[i] + column); // Sort each individual row
    }
}

void print(string contests[], double score[][column]){
    for (int r = 0; r < rows; r++){
        cout << contests[r] << " ";
        for(int c = 0; c < column; c++){
            cout << score[r][c] << " ";
        }
        cout << endl;
    }
    
}

