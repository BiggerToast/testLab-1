#include <iostream>
#include <algorithm>

using namespace std;

int main() {
    
    int data[] = {5, 2, 9, 1, 5, 6};
    int n = sizeof(data) / sizeof(data[0]);

// Sorting the array in ascending order
    sort(data, data + n);
    
    for (int i = 0; i < n; ++i) {
      cout << data[i] << " "; } // Output: 1 2 5 5 6 9
      
    return 0;
}
