   string GameCharacter::getName() const {
       return name;
   }
   void GameCharacter::setName(string newName)const{
       name = newName;
   }   
   int GameCharacter::gethealth(){
       return health;
   };
   
   void GameCharacter::sethealth(int newscore) const{
       health = newscore;
   };
