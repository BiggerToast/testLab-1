#include <iostream>
#include "gamecharacter.h"


using namespace std;

    
    
    void GameCharacter:: introduce() {
        cout << "I am " << name << "!" << endl;
        cout << "Health: " << health << endl;
        cout << "Attack Power: " << attackPower << endl;
    }

    void attack() {
        cout << name << " attacks with " << attackPower << " power!" << endl;
    }

   GameCharacter(){
        name = "";
	    health = 100;
	    attackPower = 1;
   }
   
    GameCharacter(string newName){
        name = newName;
	    health = 100;
	    attackPower = 5;
   }
   
